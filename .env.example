# Copie ce fichier en .env et remplis les valeurs. Ne commite JAMAIS le fichier .env.

# Base de données (docker-compose)
POSTGRES_USER=vigie
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=vigie
DATABASE_URL=postgresql://vigie:change-moi@localhost:5432/vigie

# API
API_PORT=3000
# Au moins 32 caractères aléatoires. Pour en générer un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=remplace-moi-par-une-longue-chaine-aleatoire
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Premier compte administrateur (utilisé par npm run db:seed)
SEED_ADMIN_EMAIL=admin@vigie.local
SEED_ADMIN_PASSWORD=ChangeMoi-AdminVigie1
