# Copie ce fichier en .env et remplis les valeurs. Ne commite JAMAIS le fichier .env.

# Base de données (docker-compose)
POSTGRES_USER=vigie
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=vigie
DATABASE_URL=postgresql://vigie:change-moi@localhost:5432/vigie

# API
JWT_ACCESS_SECRET=change-moi-secret-long-et-aleatoire
JWT_REFRESH_SECRET=change-moi-autre-secret-long-et-aleatoire
ALERTS_WEBHOOK_API_KEY=change-moi
